# Copy to .env and fill in. .env is gitignored.
#
# Routes are NOT configured here -- they live in routes.yml and are managed from
# the dashboard. This file holds settings that apply to the whole installation.

# --- Required -------------------------------------------------------------
# Google Cloud API key with the "Routes API" enabled.
GOOGLE_MAPS_API_KEY=

# --- Storage --------------------------------------------------------------
# routes.yml defaults to sitting beside the database, so one volume carries both.
DB_PATH=/data/commutes.db
# ROUTES_FILE=/data/routes.yml

# --- Server ---------------------------------------------------------------
PORT=8080
# Sets the container clock, and the default timezone offered when you add a
# route in the dashboard. Each route stores its own timezone.
TZ=America/Los_Angeles

# TRAFFIC_AWARE is fast and cheap; TRAFFIC_AWARE_OPTIMAL is more accurate and
# costs more per call.
TRAFFIC_MODEL=TRAFFIC_AWARE

# --- Daily push notification (optional) -----------------------------------
# The time each report is sent is set per route, in the dashboard. This section
# is only about how reports are scored and where they are delivered.
#
# Severity compares the day's average against the trailing baseline of daily
# averages, in standard deviations: above +threshold is red (busier than
# normal), below -threshold is green (lighter), in between is yellow (typical).
NOTIFY_BASELINE_DAYS=30
NOTIFY_MIN_BASELINE_DAYS=5
NOTIFY_THRESHOLD_SIGMA=1.0

# Configure one or both. Anything left blank is skipped.
# ntfy (https://ntfy.sh) -- install the app, subscribe to a hard-to-guess topic.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover (https://pushover.net) -- app token plus your user key.
PUSHOVER_TOKEN=
PUSHOVER_USER=
