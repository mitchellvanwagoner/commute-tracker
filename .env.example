# Copy to .env and fill in. .env is gitignored.

# --- Required -------------------------------------------------------------
# Google Cloud API key with the "Routes API" enabled.
GOOGLE_MAPS_API_KEY=

# --- The commute ----------------------------------------------------------
ROUTE_NAME=Morning commute
ORIGIN_ADDRESS=1600 Amphitheatre Parkway, Mountain View, CA
DESTINATION_ADDRESS=1 Ferry Building, San Francisco, CA

# --- The daily window -----------------------------------------------------
# Sampling runs from WINDOW_START to WINDOW_END (inclusive), every
# SAMPLE_INTERVAL_MINUTES, on the listed days, in the given timezone.
WINDOW_START=07:00
WINDOW_END=09:00
SAMPLE_INTERVAL_MINUTES=15
DAYS=mon,tue,wed,thu,fri
# TZ also sets the container clock; TIMEZONE overrides it if your shell strips TZ.
TZ=America/Los_Angeles
# TIMEZONE=America/Los_Angeles

# --- Optional -------------------------------------------------------------
# TRAFFIC_AWARE is fast and cheap; TRAFFIC_AWARE_OPTIMAL is more accurate and
# costs more per call.
TRAFFIC_MODEL=TRAFFIC_AWARE
PORT=8080
DB_PATH=/data/commutes.db
# ROUTES_FILE=routes.yml

# --- Daily push notification (optional) -----------------------------------
# Time of day to push a report of that day's commute. Set it after WINDOW_END
# so the report covers the whole window. Leave blank to disable notifications.
NOTIFY_AT=09:30
# Defaults to DAYS if left blank.
# NOTIFY_DAYS=mon,tue,wed,thu,fri

# Severity compares the day's average against the trailing baseline of daily
# averages, in standard deviations: above +threshold is red (busier than
# normal), below -threshold is green (lighter), in between is yellow (typical).
NOTIFY_BASELINE_DAYS=30
NOTIFY_MIN_BASELINE_DAYS=5
NOTIFY_THRESHOLD_SIGMA=1.0

# Configure one or both. Anything left blank is skipped.
# ntfy (https://ntfy.sh) -- install the app, subscribe to a hard-to-guess topic.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover (https://pushover.net) -- app token plus your user key.
PUSHOVER_TOKEN=
PUSHOVER_USER=
