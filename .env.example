# Copy to .env and fill in. .env is gitignored.
#
# Routes are NOT configured here -- they live in routes.yml and are managed from
# the dashboard. This file holds settings that apply to the whole installation.

# --- Required -------------------------------------------------------------
# Google Cloud API key with the "Routes API" enabled.
GOOGLE_MAPS_API_KEY=

# --- Storage --------------------------------------------------------------
# routes.yml defaults to sitting beside the database, so one volume carries both.
DB_PATH=/data/commutes.db
# ROUTES_FILE=/data/routes.yml

# --- Server ---------------------------------------------------------------
# The port on the *host* -- the one you put in the browser, as in
# http://<your-server-ip>:8080. Under Docker this only moves the host side of
# the mapping; inside the container the app always listens on 8080.
PORT=8080

# Do NOT set HOST to your server's LAN address. It is the address the app binds
# to, and under Docker that is an address inside the container, where the host's
# IP does not exist -- uvicorn then fails to bind and nothing listens, which
# looks exactly like a wrong port. The compose file pins it to 0.0.0.0 for this
# reason. It is worth setting only when running without Docker, to restrict the
# dashboard to one interface (HOST=127.0.0.1 for localhost only).
# HOST=0.0.0.0
# Sets the container clock, and the default timezone offered when you add a
# route in the dashboard. Each route stores its own timezone.
TZ=America/Los_Angeles

# TRAFFIC_AWARE is faster to return; TRAFFIC_AWARE_OPTIMAL is more accurate and
# slower. Both bill at the same rate -- Google puts either one in the "Compute
# Routes Pro" SKU -- so choose on accuracy, not on price.
TRAFFIC_MODEL=TRAFFIC_AWARE

# --- Cost guards ----------------------------------------------------------
# Every sample is a billed Routes API call. These bound what a route added in
# the dashboard can cost, so a mistyped interval cannot quietly run up a bill.
# Raise them if you deliberately want denser sampling.
#
# For scale: the Pro SKU bills per call after 5,000 free calls a month, and a
# 2-hour window sampled every 15 minutes on weekdays is ~195 calls a month.
MIN_INTERVAL_MINUTES=5
MAX_SAMPLES_PER_DAY=120

# The monthly ceiling on Routes API calls. Once it is reached the app stops
# calling the API entirely -- samples are skipped, and each skip is recorded so
# the gap in the chart explains itself -- until the next billing month.
#
# The default is Google's free allowance for the Compute Routes Pro SKU, which
# is what this app's TRAFFIC_AWARE requests bill against. Past it, Google
# charges about $10 per 1,000 calls. Set to 0 to remove the ceiling and accept
# the charges; the meter keeps counting either way.
FREE_TIER_CALLS_PER_MONTH=5000

# Google Cloud closes its billing month on Pacific time, so that is what decides
# which month a call counts against -- not the route's timezone.
BILLING_TIMEZONE=America/Los_Angeles

# --- Address suggestions --------------------------------------------------
# Where the route editor's From/To boxes get their suggestions.
#
#   photon  (default) Komoot's public OpenStreetMap geocoder. No API key, no
#           billing, nothing to enable. Built for type-ahead.
#   google  Places API (New) Autocomplete. Billed past 10,000 requests a month
#           ($2.83/1,000 after), and it must be enabled in Cloud Console AND
#           allowed on your API key's restrictions -- a key restricted to the
#           Routes API alone will reject it.
#   off     No suggestions; the boxes stay plain text.
#
# Suggestions are only a convenience either way: the editor's Test button is
# what proves an address actually resolves for the Routes API.
ADDRESS_PROVIDER=photon

# --- Daily push notification (optional) -----------------------------------
# The time each report is sent is set per route, in the dashboard. This section
# is only about how reports are scored and where they are delivered.
#
# Severity compares the day's average against the trailing baseline of daily
# averages, in standard deviations: above +threshold is red (busier than
# normal), below -threshold is green (lighter), in between is yellow (typical).
NOTIFY_BASELINE_DAYS=30
NOTIFY_MIN_BASELINE_DAYS=5
NOTIFY_THRESHOLD_SIGMA=1.0

# Configure one or both. Anything left blank is skipped.
# ntfy (https://ntfy.sh) -- install the app, subscribe to a hard-to-guess topic.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover (https://pushover.net) -- app token plus your user key.
PUSHOVER_TOKEN=
PUSHOVER_USER=
